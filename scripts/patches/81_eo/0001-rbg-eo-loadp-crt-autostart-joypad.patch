diff --git a/src/eo.c b/src/eo.c
index e4f5d5c..5cfb3b5 100644
--- a/src/eo.c
+++ b/src/eo.c
@@ -346,6 +346,27 @@ void eo_loadp( const void* data, size_t size )
   z80.iy.w = 0x4000;
   z80.i = 0x1e;
   z80.r = 0xca;
+
+  /* RBG PH-12.1: z88dk +zx81 CRT autostart for .p homebrew (e.g. MIT Dot).
+   * Enter CRT at $4092. Clear CDFLAG bit6 and skip altint_on FRAMES spin ($40EB)
+   * so ROM SLOW/NMI can complete under EightyOne instead of deadlocking/BASIC.
+   */
+  if ( memory[ 0x4092 ] == 0xfd && memory[ 0x4093 ] == 0x21 )
+  {
+    memory[ 0x403B ] &= (uint8_t)~0x40;
+    if ( memory[ 0x40eb ] == 0x28 && memory[ 0x40ec ] == 0x07 )
+      memory[ 0x40eb ] = 0x18; /* jr z -> jr always */
+    z80.ix.w = 0x0281;
+    z80.iy.w = 0x4000;
+    z80.i = 0x1e;
+    z80.iff1 = 0;
+    z80.iff2 = 0;
+    z80.sp.w = 0x7ffc;
+    memory[ z80.sp.w + 0 ] = 0x76;
+    memory[ z80.sp.w + 1 ] = 0x06;
+    z80.pc.w = 0x4092;
+  }
+  (void)size;
 }
 
