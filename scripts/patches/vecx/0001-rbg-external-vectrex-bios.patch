+static bool rbg_try_load_bios_path(const char *path)
+{
+   FILE *fp;
+   size_t n;
+   long sz;
+
+   if (!path || !path[0])
+      return false;
+   fp = fopen(path, "rb");
+   if (!fp)
+      return false;
+   if (fseek(fp, 0, SEEK_END) != 0)
+   {
+      fclose(fp);
+      return false;
+   }
+   sz = ftell(fp);
+   if (sz != 8192)
+   {
+      fclose(fp);
+      return false;
+   }
+   rewind(fp);
+   n = fread(bios_data, 1, 8192, fp);
+   fclose(fp);
+   if (n != 8192)
+      return false;
+   bios_data_size = 8192;
+   rbg_bios_ready = true;
+   return true;
+}
+
+static bool rbg_load_vectrex_bios(void)
+{
+   const char *sysdir = NULL;
+   char path[4096];
+   const char *names[] = {
+      "system.img",
+      "vectrex.bin",
+      "bios.bin",
+      "vecx.rom",
+      NULL
+   };
+   size_t i;
+
+   rbg_bios_ready = false;
+   if (environ_cb)
+      environ_cb(RETRO_ENVIRONMENT_GET_SYSTEM_DIRECTORY, &sysdir);
+
+   if (sysdir && sysdir[0])
+   {
+      for (i = 0; names[i]; i++)
+      {
+         snprintf(path, sizeof(path), "%s/%s", sysdir, names[i]);
+         if (rbg_try_load_bios_path(path))
+         {
+            if (log_cb)
+               log_cb(RETRO_LOG_INFO, "[vecx] loaded user BIOS %s\n", path);
+            return true;
+         }
+         snprintf(path, sizeof(path), "%s%s%s", sysdir,
+               (sysdir[strlen(sysdir) - 1] == '/' ||
+                sysdir[strlen(sysdir) - 1] == '\\') ? "" : "/",
+               names[i]);
+         if (rbg_try_load_bios_path(path))
+         {
+            if (log_cb)
+               log_cb(RETRO_LOG_INFO, "[vecx] loaded user BIOS %s\n", path);
+            return true;
+         }
+      }
+   }
+
+   /* Also try content-adjacent / cwd for EmulatorJS mounts */
+   for (i = 0; names[i]; i++)
+   {
+      if (rbg_try_load_bios_path(names[i]))
+      {
+         if (log_cb)
+            log_cb(RETRO_LOG_INFO, "[vecx] loaded user BIOS ./%s\n", names[i]);
+         return true;
+      }
+   }
+
+   if (log_cb)
+      log_cb(RETRO_LOG_ERROR,
+            "[vecx] MISSING_VECTREX_BIOS: place authorized 8192-byte system.img in system directory\n");
+   return false;
+}
