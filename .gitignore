.venv/
.env
compose.override.yaml
*.sqlite3
__pycache__/
*.pyc
.ruff_cache/
node_modules/
.next/
*.tsbuildinfo
.runtime/
staticfiles/
*.log
fixtures/*/build/
fixtures/*/*.o
fixtures/*/src/*.o
fixtures/*/*.elf
fixtures/*/EBOOT.PBP
fixtures/*/PARAM.SFO
fixtures/*/assets/tone.wav
docs/test-evidence/PH-06/.sec-tmp/

# Ephemeral Chromium profiles created by offline/console journey tests.
docs/test-evidence/**/.offline-profile*/
docs/test-evidence/**/.offline-profile/

# Private runtime asset root (emulator .data/.wasm and company-provisioned payloads).
# Canonical local default; override with RBG_PRIVATE_ASSET_DIR.
.private-runtime/

# Portable private-asset backups must never enter Git (keep outside the repo).
RetroBrowserGaming-Asset-Backup/
RetroBrowserGaming-Asset-Backup-*/

# Corresponding-source offer assemblies (operator-built; keep outside Git).
RetroBrowserGaming-Corresponding-Source-Offer/
RetroBrowserGaming-Corresponding-Source-Offer-*/

# Working-tree copies of private core binaries (provisioned; not for public Git).
apps/web/public/cores/**/*.data
apps/web/public/cores/**/*.wasm
apps/web/.playwright-browsers/

# Generated QA evidence (never commit). Use RBG_TEST_EVIDENCE_DIR to override.
docs/test-evidence/
.runtime/test-evidence/

# Large generated Dreamcast disc images (rebuild via scripts/build-dreamcast-disc-fixtures.sh).
# Keep multi-hundred-MiB CDI out of Git; truncated GDI tracks may be committed when small.
.fixtures/*.cdi
.fixtures/dreamcast-dot.cdi
.fixtures/mit-dreamcast-dot.cdi
.fixtures/mit-dreamcast-dot-gdi/
.fixtures/mit-dreamcast-dot-disc2-gdi/
.fixtures/dreamcast-gdi/
.fixtures/*.mds
.fixtures/*.mdf
.fixtures/*.nrg
.fixtures/disc-build/
.fixtures/*.cdi.sha256
.fixtures/mit-dreamcast-dot.cdi.sha256
.fixtures/dreamcast-dot.cdi.sha256
