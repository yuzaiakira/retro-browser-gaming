# LOCAL DEVELOPMENT ONLY; run scripts/init-env.py to generate noncommitted values.
DJANGO_SECRET_KEY=replace-with-a-random-key-at-least-50-characters-long
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
# Engineering fixtures (seed --with-console-fixtures) are visible only when true.
# Production must leave this false/unset so only product-approved titles appear.
# With DJANGO_DEBUG=false, also requires CATALOG_ALLOW_ENGINEERING_IN_PRODUCTION=true
# (enforced by `manage.py check --deploy`, catalog.E001).
CATALOG_ALLOW_ENGINEERING=true
# CATALOG_ALLOW_ENGINEERING_IN_PRODUCTION=false
# Direct S3 GET TTL seconds (gateway/proxy re-checks visibility each request):
# S3_PRESIGNED_URL_EXPIRES=900
DATABASE_URL=postgresql://retro:replace-local-db-password@db:5432/retro
POSTGRES_USER=retro
POSTGRES_PASSWORD=replace-local-db-password
POSTGRES_DB=retro
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://object-store:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=retro-demo
S3_ACCESS_KEY_ID=retro-local
S3_SECRET_ACCESS_KEY=replace-local-object-store-secret
S3_REGION=us-east-1
PUBLIC_APP_ORIGIN=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Private emulator binary root (.data/.wasm). Default: ./.private-runtime
# Compose mounts this read-only into the web container as /private-runtime.
# RBG_PRIVATE_ASSET_DIR=.private-runtime
# Core lock mode for CI source checks: SOURCE_ONLY | LOCAL_FULL | PRODUCTION_FULL
# RBG_CORE_LOCK_MODE=SOURCE_ONLY
# Private core provision (compose.yaml defaults to PUBLIC_BROWSER — safe for public deploys).
# For full local emulator binaries, use compose.override.example.yaml which sets:
#   RBG_ALLOW_LOCAL_FULL=1
#   RBG_CORE_PROVISION_MODE=LOCAL_FULL
# Entrypoint refuses LOCAL_FULL unless RBG_ALLOW_LOCAL_FULL=1 (blocks prod drift).
# Optional corresponding-source offer URL (HTTPS). Env alone never verifies delivery —
# scripts/check-source-offer-gate.py must fetch OFFER_MANIFEST.json + SHA256SUMS.
# RBG_SOURCE_OFFER_PUBLIC_URL=https://example.com/corresponding-source/<git-sha>/
# Optional Alpha feedback (no tracker; only used if the user clicks a link):
# NEXT_PUBLIC_ALPHA_FEEDBACK_MAILTO=feedback@example.com
# NEXT_PUBLIC_ALPHA_FEEDBACK_URL=https://example.com/alpha-feedback

